# deploy/.env — used by docker-compose.prod.yml (copy to deploy/.env on the VPS)

# Image built by GitHub Actions. Pin a tag for reproducible deploys.
MONIFY_IMAGE=ghcr.io/gewall/monify-go:latest

# Host loopback port the app publishes; the host nginx proxies to it.
APP_PORT=8090

# Shared PostgreSQL (~/infra/postgres). Host "postgres" resolves over the
# external "shared-db" docker network. Credentials from create-project-db.sh.
DATABASE_URL=postgres://monify:REPLACE_WITH_DB_PASSWORD@postgres:5432/monify?sslmode=disable

# Long random string, e.g. `openssl rand -base64 48`
SESSION_SECRET=generate-a-long-random-string
