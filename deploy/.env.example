# deploy/.env — used by docker-compose.prod.yml (copy to deploy/.env on the VPS)
MONIFY_IMAGE=ghcr.io/alginugraha/monify:latest

POSTGRES_USER=monify
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=monify

DATABASE_URL=postgres://monify:change-me-strong@db:5432/monify?sslmode=disable
SESSION_SECRET=generate-a-long-random-string
